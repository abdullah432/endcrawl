<plist version="1.0">
<dict>
	<!-- App Store builds: manual signing with the COOKOO distribution profile,
	     so no registered device is needed. Use:
	     flutter build ipa --export-options-plist=ios/ExportOptions.plist -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>UA47GB93N8</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.lastreel.app</key>
		<string>LastReel App Store</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
