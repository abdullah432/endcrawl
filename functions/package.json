{
  "name": "lastreel-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "test:profiles": "node scripts/test-profiles.mjs",
    "prepare:profile-pilot": "node scripts/prepare-profile-pilot.mjs",
    "prepare:profile-deployment": "npm run build && node scripts/prepare-profile-deployment.mjs",
    "verify:profile-pilot": "node scripts/verify-profile-pilot.mjs --admin-exercise",
    "prepare:billing-deployment": "npm run build && node scripts/prepare-billing-deployment.mjs",
    "verify:billing-pilot": "node scripts/verify-billing-pilot.mjs --exercise-webhook"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "^22.18.0",
    "firebase": "12.19.0",
    "typescript": "^5.9.3"
  }
}
